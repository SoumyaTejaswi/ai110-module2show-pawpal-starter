classDiagram
    class Owner {
        +String name
        +Dict preferences
        +add_pet(pet) void
        +set_preferences(prefs) void
    }

    class Pet {
        +String name
        +String species
        +String breed
        +List~Task~ tasks
        +add_task(task) void
        +edit_task(task_id, changes) void
        +remove_task(task_id) void
        +get_tasks() List~Task~
    }

    class Task {
        +String name
        +String category
        +int duration
        +String priority
        +bool recurring
        +String preferred_time
        +conflicts_with(other_task) bool
        +is_due_today() bool
    }

    class Scheduler {
        +int available_time
        +List~Task~ tasks
        +sort_tasks() List~Task~
        +filter_tasks() List~Task~
        +resolve_conflicts() List~Task~
        +generate_plan() DailyPlan
    }

    class DailyPlan {
        +List~Task~ scheduled_tasks
        +List~Task~ skipped_tasks
        +Dict explanations
        +display() String
        +explain(task) String
    }

    Owner "1" --> "many" Pet : owns
    Pet "1" --> "many" Task : has
    Scheduler "1" --> "many" Task : reads
    Scheduler --> DailyPlan : generates
